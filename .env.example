# Переменные для docker-compose.yml (проверен 2026-07-17).
# Для запуска без Docker правьте backend/.env и ntt-calculator/.env —
# этот файл на них НЕ влияет.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=ntt
# Обязателен: compose откажется стартовать без него.
POSTGRES_PASSWORD=
POSTGRES_DB=ntt_estimates

# Роль приложения — без прав суперпользователя (План_устранения 2.6).
# Задайте пароль, и на НОВОЙ установке база заведёт отдельную роль, которой
# ходит бэкенд: она владеет только схемой своей базы, ролями и кластером не
# управляет. Пусто — приложение ходит ролью POSTGRES_USER, как раньше.
# Рабочую базу на такую роль переводят процедурой из РАЗВЁРТЫВАНИЕ.md.
APP_DB_USER=ntt_app
APP_DB_PASSWORD=

# ── Backend ──────────────────────────────────────────────────────────────────
# Обязателен. Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── Публикация ───────────────────────────────────────────────────────────────
HTTP_PORT=80
# Внешний адрес сервиса. Для Битрикс24 (ТЗ §10.1) — постоянное доменное имя
# с валидным TLS: https://calc.<домен-компании>
PUBLIC_URL=http://localhost

# Демо-учётки остальных ролей (MANAGER/ENGINEER/TECHNOLOG/VIEWER).
# 0 или пусто — сид заводит только администратора, остальные создаются вручную.
# 1 — заводить (локальная разработка, verify.ps1).
SEED_DEMO_USERS=0

# Пароль первого администратора (admin@ntt.local), не короче 8 знаков.
# Пусто — сид сгенерирует случайный и один раз напечатает его в лог бэкенда:
#   docker compose logs backend | grep "пароль первого администратора"
# В обоих случаях при первом входе пароль обязательно сменить.
ADMIN_INITIAL_PASSWORD=

# ── Коммерческое предложение ─────────────────────────────────────────────────
# Постоянная часть печатной формы. Пусто — берутся значения по умолчанию из
# кода (backend/src/utils/kp-terms.ts): реквизиты НТТ и условия из эталона.
# Подпись и телефон отдела своё значение имеют у каждой установки.
# KP_SIGNER_TITLE=Коммерческий директор
# KP_SIGNER_NAME=Иванов Сергей Владимирович
# Телефон исполнителя, если в его учётной записи телефона нет.
# KP_EXECUTOR_PHONE=+7 (499) 940 14 04
# Приставка сквозного номера КП: «КП-0042».
# KP_NUMBER_PREFIX=КП-
# Срок поставки и склад отгрузки — подставляются в пункты условий.
# KP_LEAD_TIME_DAYS=40-50
# KP_WAREHOUSE=Московская область, г.о. Сергиево-Посадский, д. Коврово
# Реквизиты в подвале: KP_COMPANY_NAME, KP_COMPANY_OGRN, KP_COMPANY_INN,
# KP_COMPANY_PHONE, KP_COMPANY_ADDRESS, KP_COMPANY_EMAIL, KP_COMPANY_SITE.

# Сколько прокси стоит перед бэкендом: адрес клиента для лимита попыток входа
# берётся из X-Forwarded-For. 1 — nginx этого compose (по умолчанию). Поставили
# перед ним ещё прокси (TLS, балансировщик) — 2, а в nginx — модуль realip.
TRUST_PROXY=1
