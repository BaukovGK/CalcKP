# Контекст сборки образа backend (docker-compose.yml, build.context: ./backend).
#
# Dockerfile ставит зависимости сам (npm ci) и компилирует src/ и prisma/seed.ts;
# хостовые node_modules и dist в образ не нужны — они собраны под другую
# платформу и перекрыли бы результат сборки.

# Секреты: .env содержит JWT_SECRET и пароль БД
.env
.env.*
!.env.example

# Зависимости и сборка
node_modules
dist
dist-seed
*.tsbuildinfo

# Логи и кеши
*.log
coverage
