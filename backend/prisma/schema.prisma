generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  ENGINEER
  TECHNOLOG // Редактор каталога компонентов и шаблонов (ТЗ §2, Библиотека §6.2)
  BUYER
  VIEWER
}

enum DeviceType {
  KNS // Канализационная насосная станция
  EMK // Ёмкость
  KOL // Колодец
}

enum Status {
  DRAFT
  CALC
  REVIEW
  APPROVED
  REJECTED
}

// ── Users ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  role         Role     @default(VIEWER)
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects         Project[]
  estimates        Estimate[]
  auditLogs        AuditLog[]
  priceChanges     PriceHistory[]
  priceVersions    PriceListVersion[]
  nodeVersions     NodeDefVersion[]
  templateVersions ProductTemplateVersion[]
}

// ── Projects ───────────────────────────────────────────────────────────────

model Project {
  id        String     @id @default(uuid())
  title     String // Название объекта
  address   String? // Адрес объекта
  customer  String? // Заказчик
  notes     String?
  authorId  String
  author    User       @relation(fields: [authorId], references: [id])
  estimates Estimate[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// ── Estimates ──────────────────────────────────────────────────────────────

model Estimate {
  id         String     @id @default(uuid())
  title      String // Обозначение единицы, напр. «КНС DN3000»
  deviceType DeviceType
  status     Status     @default(DRAFT)
  /// Параметры опросного листа + материализованное дерево расчёта
  /// (сборки -> компоненты -> строки с зафиксированными значениями и
  /// overrides). ТЗ §3, §9; Библиотека §4, §6.3 — дерево хранится
  /// JSON-документом, реляционно только разделяемое.
  surveyData Json
  totalRub   Float?
  projectId  String?
  project    Project?   @relation(fields: [projectId], references: [id])
  authorId   String
  author     User       @relation(fields: [authorId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  snapshots EstimateSnapshot[]
}

// ── Snapshots (версионирование расчётов) ──────────────────────────────────

model EstimateSnapshot {
  id               String   @id @default(uuid())
  estimateId       String
  estimate         Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  version          Int
  priceListVersion Int
  totalRub         Float
  bundlesJson      Json // полный CalcBundle[] snapshot
  /// Зачем снят слепок — от этого зависит, что с ним можно делать
  /// (utils/snapshot-reason.ts). По умолчанию KP: до появления поля все
  /// снапшоты снимались выпуском КП или ручной фиксацией и печатались как КП.
  reason           SnapshotReason @default(KP)
  /// Версия шаблона изделия, по которой собран состав дерева: 0 — встроенный
  /// шаблон из кода, N — опубликованная технологом. null — слепок снят до
  /// появления редактора шаблонов или с дерева без отметки версии.
  templateVersion  Int?
  /// Редакция встроенного шаблона изделия — версия кода, которым собран
  /// состав: формулы и состав встроенных узлов, исполнение узлов каталога
  /// (ntt-calculator/src/engines/builtin-revisions.ts). null — слепок снят
  /// до учёта редакций.
  builtinRevision  Int?
  createdAt        DateTime @default(now())

  @@unique([estimateId, version])
}

/// Причина слепка расчёта.
enum SnapshotReason {
  /// Слепок при создании единицы изделия — исходное состояние, с которого
  /// расчёт начал жить. Проверку строк без цены не проходил, поэтому КП по
  /// нему не печатается и удалять единицу он не мешает.
  CREATE
  /// Ручная фиксация версии из окна «Версии».
  MANUAL
  /// Выпуск КП: прошёл проверку строк без цены, цена ушла заказчику.
  KP
}

// ── Price list ─────────────────────────────────────────────────────────────

/// Версия прайса целиком (ТЗ §3: «Прайс версионируется целиком… Активная
/// версия фиксируется в snapshot расчёта»). Реальные файлы содержат два
/// поколения НН (ФОТ 1002 -> 1207,8; накладные 1089,56 -> 1584,73).
/// Текущая версия = MAX(version); импорт прайса создаёт новую.
model PriceListVersion {
  id          String   @id @default(uuid())
  version     Int      @unique
  label       String? // напр. «НН v2 от 20.05» — показывается в топбаре калькулятора
  note        String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model PriceItem {
  id        String @id @default(uuid())
  /// Производный от тройки ключ «category:name:unit» — сохранён для
  /// совместимости и отладки; источник истины уникальности — @@unique ниже.
  lookupKey String @unique

  category String
  name     String
  unit     String

  priceBaseRub Float? // Цена без скидки (НН, кол. G)
  discountPct  Float? // Скидка % (НН, кол. I — в текущих файлах не заполнена)
  currency     String  @default("руб") // НН, кол. H (мультивалютность заложена, не активна)
  priceRub     Float? // Итоговая цена (НН, кол. J) — именно её тянет VLOOKUP
  supplier     String? // В листе НН отсутствует: при импорте не заполняется
  comment      String? // НН, кол. K

  updatedAt DateTime @updatedAt

  history PriceHistory[]

  /// Реальный ключ прайса — тройка (категория, наименование, ЕИ):
  /// VLOOKUP(C&D&K, НН!A:J, 10). Одно наименование существует с разными ЕИ.
  @@unique([category, name, unit])
  @@index([category])
}

model PriceHistory {
  id          String    @id @default(uuid())
  priceItemId String
  priceItem   PriceItem @relation(fields: [priceItemId], references: [id], onDelete: Cascade)
  oldPrice    Float?
  newPrice    Float?
  changedById String?
  changedBy   User?     @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime  @default(now())

  @@index([priceItemId, changedAt])
}

// ── Справочники (извлекаются из «Шаблон 3.0.xlsx», tools/extract-refs.ts) ──

/// Веса GRP-труб: ключ (DN; PN; SN) -> кг/пм. 162 позиции, DN 300…3000.
/// ВНИМАНИЕ (ТЗ §9.4): PN здесь — это PN_трубы (автоподбор, ячейка F7),
/// а НЕ PN опросного листа. Домены: PN {0,6; 1; 1,6}, SN {2500; 5000; 10000}.
model PipeWeight {
  id     String @id @default(uuid())
  dn     Int
  pn     Float
  sn     Int
  wallMm Float?
  kgPerM Float

  @@unique([dn, pn, sn])
}

/// Тип инженерной матрицы листа «Для расчетов» (Реверс §9.3).
enum MatrixKind {
  /// Вес и толщина корпуса = f(Dу, L).
  SHELL
  /// Формовка эллиптических днищ = f(Dн, L).
  ELLIPTIC_BOTTOM
}

/// Инженерные матрицы f(D, L) — лист «Для расчетов».
/// Обе матрицы устроены одинаково (пары колонок «кг» / «мм» по диаметрам,
/// строки по длине), поэтому лежат в одной таблице с дискриминатором `kind`,
/// а не в двух близнецах.
model EngineeringMatrix {
  id          Int        @id @default(autoincrement())
  kind        MatrixKind
  /// Dу (корпус) или Dн (днище), мм.
  d           Int
  /// Длина изделия, мм: 3000…12000.
  lengthMm    Int
  massKg      Float
  thicknessMm Float?

  @@unique([kind, d, lengthMm])
  @@index([kind])
}

/// Нормы простого патрубка = f(DN), лист «Для расчетов», строки 36–62.
/// На них считается формовка гильз и фланцев (Библиотека A5, A6).
model NozzleNorm {
  id Int @id @default(autoincrement())
  /// Диаметр номинальный, мм — ключ.
  dn Int @unique

  odMm          Float?
  minLengthMm   Float?
  /// Мф общая — масса формовки, кг.
  moldingMassKg Float
  h1Mm          Float?
  s1Mm          Float?
  /// Мф фланца, кг.
  flangeMassKg  Float?
  /// Болтовое соединение фланца, напр. «М24х100».
  bolt          String?
  boltCount     Int?
}

/// Мс — масса формованных слоёв на стыке = f(Dу, PN), лист «Для расчетов»,
/// диапазон J36:S143: 21 диаметр (1000…3000 через 100) × 5 давлений (4, 6, 10,
/// 16, 20 атм), 105 строк без пропусков.
///
/// Читают её КНС («Ламинирование частей корпуса») и ЕМК («Ламинация днища»),
/// причём ОБА берут строку с НАИМЕНЬШИМ давлением. Правило завода
/// (2026-09-09): изделия безнапорные, поэтому считается минимально возможная
/// ламинация. Таблица задана в АТМОСФЕРАХ, и нижняя строка — 4 атм, то есть
/// 0,4 МПа. Остальные давления в расчёт не идут и хранятся справочно —
/// технолог сверяет по ним строку с чертежом.
model JointLayerNorm {
  id Int @id @default(autoincrement())
  /// Dу, мм — часть ключа.
  d  Int
  /// Внутреннее давление PN, атм — вторая часть ключа.
  pn Int

  /// Наружный диаметр трубы, мм (в листе указан один на группу Dу).
  odMm    Float?
  hMm     Float?
  sMm     Float?
  xMm     Float?
  /// Заполнен лишь у 10 строк из 105 — в листе колонка почти пустая.
  yMm     Float?
  /// Мс — масса формованных слоёв на стыке, кг.
  massKg  Float

  @@unique([d, pn])
  @@index([d])
}

/// ПЭ-трубы ПЭ-100 SDR17, 26 позиций.
/// Ключ — наружный диаметр `odMm`, а НЕ `dn`: в листе колонка «DN» — условный
/// проход, и она не уникальна (DN 125 указан и для ⌀125, и для ⌀140), к тому же
/// нерегулярна (DN 25 -> ⌀32, DN 45 -> ⌀50).
model PePipe {
  id     String  @id @default(uuid())
  dn     Int
  name   String  @unique
  odMm   Float   @unique
  wallMm String?
  kgPerM Float

  @@index([dn])
}

/// Каталог насосного оборудования — подбор по расходу и напору (рабочая
/// точка), utils/pump-selection.ts. Диаметр патрубка — атрибут насоса
/// (справочно), не критерий отбора: реальный подбор (программа
/// производителя VJ Select, том ИМИП-ДУДС24и) идёт по пересечению
/// характеристики насоса с характеристикой сети, т.е. по (Q, H) вместе.
model Pump {
  id Int @id @default(autoincrement())
  /// Марка/модель насоса — то, что возвращает функция подбора.
  name String @unique
  /// Артикул производителя — есть у моделей из выгрузки VJ Select.
  article String?
  /// Диапазон расхода (производительности), м³/ч.
  capacityMinM3h Float
  capacityMaxM3h Float
  /// Диапазон напора, м.
  headMinM Float
  headMaxM Float
  /// Номинальная рабочая точка по паспорту, если известна.
  qNomM3h Float?
  hNomM   Float?
  /// Диаметр напорного патрубка насоса, мм — справочно (не участвует в подборе).
  nozzleDiameterMm Int

  /// Паспортная характеристика Q–H. Есть у 56 моделей из 61: пять DN50/DN65
  /// пришли из вторичных источников, кривых для них производитель не отдал.
  /// Подбор без кривой возможен, но только грубый (см. utils/pump-selection.ts).
  curve PumpCurvePoint[]
}

/// Точка паспортной характеристики насоса (лист выгрузки VJ Select).
///
/// Кривая невозрастающая по напору и упорядочена по расходу: на этом стоит
/// интерполяция рабочей точки. `idx` хранит исходный порядок точек.
model PumpCurvePoint {
  id     Int  @id @default(autoincrement())
  pumpId Int
  pump   Pump @relation(fields: [pumpId], references: [id], onDelete: Cascade)

  idx Int
  /// Расход, м³/ч.
  q Float
  /// Напор, м.
  h Float
  /// Мощность на валу (P2) и потребляемая (P1), кВт.
  p2 Float
  p1 Float
  /// КПД в точке, %.
  eff Float

  @@unique([pumpId, idx])
  @@index([pumpId, q])
}

// ── Каталог узлов и шаблоны изделий (редактор шаблонов, этап 2) ────────────

/// Узел каталога, заведённый технологом (Библиотека §1.1, §4, §6.2):
/// параметры, строки состава с формулами количеств и генераторами
/// наименований. Встроенные узлы — обечайка, лестница, напорный
/// трубопровод… — в БД не хранятся: их формулы и реестр — код
/// (ntt-calculator/src/engines/code-nodes.ts).
///
/// «Черновик → опубликован»: технолог правит `draft`, публикация пишет
/// новую неизменяемую версию в NodeDefVersion и делает её действующей.
/// Материализованный компонент помнит версию узла (`nodeVersion`) — по ней
/// видно, каким составом он собран.
model NodeDef {
  id            String   @id @default(uuid())
  /// Код каталога: «B5», «C7». Уникален; коды встроенных узлов заняты.
  code          String   @unique
  /// Черновик — тело узла; null — черновика нет.
  draft         Json?
  /// Действующая версия; null — узел ещё не публиковался.
  activeVersion Int?
  /// В архиве: не предлагается в шаблоны и в расчёт. Шаблон, который его
  /// использует, не даст убрать узел в архив.
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  versions NodeDefVersion[]
}

/// Опубликованная версия узла каталога — неизменяема.
model NodeDefVersion {
  id            String   @id @default(uuid())
  nodeId        String
  node          NodeDef  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  version       Int
  body          Json
  /// Что изменилось — пишет технолог при публикации.
  note          String?
  publishedById String?
  publishedBy   User?    @relation(fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt   DateTime @default(now())

  @@unique([nodeId, version])
}

/// Шаблон изделия (Библиотека §1.5: сборка верхнего уровня с биндингами
/// параметров на поля ОЛ) — один на тип изделия. Версия 0 — встроенный
/// шаблон из кода: пока `activeVersion` пуст, расчёты собираются им.
model ProductTemplate {
  id            String     @id @default(uuid())
  deviceType    DeviceType @unique
  /// Черновик — разделы и узлы; null — черновика нет.
  draft         Json?
  /// Действующая версия; null — встроенный шаблон (версия 0).
  activeVersion Int?
  updatedAt     DateTime   @updatedAt

  versions ProductTemplateVersion[]
}

/// Опубликованная версия шаблона изделия — неизменяема; снапшот КП хранит
/// её номер (`EstimateSnapshot.templateVersion`).
model ProductTemplateVersion {
  id            String          @id @default(uuid())
  templateId    String
  template      ProductTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version       Int
  body          Json
  note          String?
  publishedById String?
  publishedBy   User?           @relation(fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt   DateTime        @default(now())

  @@unique([templateId, version])
}

// ── Audit log ──────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // напр. «estimate.create», «prices.import»
  entityType String?
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
