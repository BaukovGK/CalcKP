DATABASE_URL="postgresql://ntt:secret@localhost:5432/ntt_estimates"
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

JWT_SECRET=change_me_in_production_use_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Дальше — необязательное: без этих переменных бэкенд работает на умолчаниях.

# Сколько прокси перед бэкендом (адрес клиента для лимита попыток входа).
TRUST_PROXY=1

# Дампы базы: каталог и сколько хранить каждого вида.
BACKUP_DIR=./backups
BACKUP_KEEP=30

# Пароль первого администратора; пусто — сид сгенерирует и напечатает в лог.
ADMIN_INITIAL_PASSWORD=
# 1 — завести демо-учётки остальных ролей (локальная разработка, verify.ps1).
SEED_DEMO_USERS=0

# Шапка и подвал КП: KP_NUMBER_PREFIX, KP_SIGNER_TITLE, KP_SIGNER_NAME,
# KP_EXECUTOR_PHONE, KP_LEAD_TIME_DAYS, KP_WAREHOUSE и реквизиты KP_COMPANY_*.
# Пусто — печатаются умолчания завода из backend/src/utils/kp-terms.ts.
# Полный список с пояснениями — в .env.example в корне репозитория.
